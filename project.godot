config_version=5

[application]

config/name="Just Neko"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")
run/main_scene="res://Main.tscn"
config/icon="res://assets/icon.svg"
boot_splash/show_image=false
boot_splash/bg_color=Color(0, 0, 0, 0)

[display]

window/size/viewport_width=224
window/size/viewport_height=254
window/size/borderless=true
window/size/transparent=true
window/size/always_on_top=true
window/size/no_focus=true
window/per_pixel_transparency/allowed=true
window/subwindows/embed_subwindows=false
window/energy_saving/keep_screen_on=false

[dotnet]

project/assembly_name="JustNeko"

[importer_defaults]

texture={
"mipmaps/generate": true
}

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
viewport/transparent_background=true

[editor_plugins]

enabled=PackedStringArray("res://addons/vrm/plugin.cfg")
